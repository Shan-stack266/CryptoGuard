# Server only. Do not prefix these values with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
# Optional additional exact site origins, comma separated. Local aliases work in development.
# APP_ALLOWED_ORIGINS=http://localhost:5174
PORT=3001
# Set NODE_ENV=production for the production API (HTTPS cookies).
# Set true only behind a trusted reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false

